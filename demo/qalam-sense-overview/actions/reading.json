{
  "version": 1,
  "id": "reading",
  "target": "web",
  "url": "http://localhost:5175/?banner=0&demo=student&profile=effortful&advance=0",
  "viewport": { "width": 1440, "height": 810 },
  "setup": [
    { "type": "click", "selectors": [".text-card"], "label": "open text" },
    { "type": "click", "selectors": ["role=button[name=\"Oui, avec la caméra\"]"], "label": "use camera" },
    { "type": "wait", "selector": "text=Parfait, je te vois bien", "label": "face ok" },
    { "type": "dwell", "ms": 1500, "label": "ready unlocks" },
    { "type": "click", "selectors": ["role=button[name=\"Je suis prêt\"]"], "label": "ready" },
    { "type": "click", "selectors": ["role=button[name=\"C’est parti\"]"], "label": "start calibration" },
    { "type": "dwell", "ms": 20000, "label": "calibration runs" },
    { "type": "wait", "selector": "[data-reader]", "label": "reader open" },
    { "type": "dwell", "ms": 21500, "label": "effortful reading builds up" }
  ],
  "steps": [
    { "type": "wait", "selector": ".toast", "label": "the engine raises support" },
    { "type": "dwell", "ms": 3500, "label": "text relaxes", "weight": 2 },
    { "type": "highlight", "selectors": ["role=button[name=\"Remettre comme avant\"]"], "ms": 2000, "label": "undo is always there", "pinToWord": "undo" },
    { "type": "dwell", "ms": 1000, "label": "hold" }
  ]
}
